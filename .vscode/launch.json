  "version": "0.2.0",
  "configurations": [
    {
      "name": "REPL",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Factorial example",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "args": "${workspaceFolder}/examples/factorial.🍝"
    },
    {
      "name": "Flowcontrol example",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "args": "${workspaceFolder}/examples/flowcontrol.🍝"
    },
    {
      "name": "Recursion example",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "args": "${workspaceFolder}/examples/recursion.🍝"
    },
    {
      "name": "Imports and classes example",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "args": "${workspaceFolder}/examples/imports.🍝"
    },
    {
      "name": "Custom file",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "args": "${command:pickArgs}"
    },
        {
      "name": "Generate AST",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tool/generate_ast.py",
      "console": "integratedTerminal",
      "args": ["spamoji"]
    }
  ]
}
